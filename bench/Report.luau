--!strict
--- Runs every library through every scenario and the cost measurements, and writes bench/Benchmarks.md.
---
---     luneblox run bench/download        (once: the rivals)
---     luneblox run bench/Report [seeds]  (default 20)
const Cost = require("./Cost")
const KeepBloxAdapter = require("@sim/KeepBloxAdapter")
const Rival = require("./adapters/Rival")
const Scenarios = require("@sim/Scenarios")
const fs = require("@lune/fs")
const process = require("@lune/process")

const ORDER = { "rejoin", "handoff", "crash", "partitioned", "thirdRequester", "shutdown", "outage", "poison", "soup" }
const TYPES = { "StandardRead", "StandardWrite", "OrderedRead", "OrderedWrite", "OrderedList" }

type Entry = { adapter: any, version: string }

const LIBRARIES: { Entry } = {
	{ adapter = KeepBloxAdapter.default, version = "this branch" },
	{ adapter = require("@sim/ProfileStoreAdapter"), version = "1.0.3 (vendored, tests/reference)" },
	{ adapter = require("./adapters/ProfileServiceAdapter"), version = Rival.version("ProfileService") },
	{ adapter = require("./adapters/DocumentServiceAdapter"), version = Rival.version("DocumentService") },
	{ adapter = require("./adapters/LapisAdapter"), version = Rival.version("Lapis") },
	{ adapter = require("./adapters/DataStore2Adapter"), version = Rival.version("DataStore2") },
}

const seeds = tonumber(process.args[1]) or 20
const out: { string } = {}
const function line(text: string?)
	table.insert(out, text or "")
end
const function fixed(value: number): string
	return string.format("%.1f", value)
end

type Row = { name: string, soaks: { [string]: Scenarios.Soak } }
const rows: { Row } = {}
for _, entry in LIBRARIES do
	const soaks = {}
	for _, name in ORDER do
		soaks[name] = Scenarios.soak(Scenarios.byName[name], entry.adapter, seeds)
	end
	table.insert(rows, { name = entry.adapter.name, soaks = soaks })
	print(`{entry.adapter.name}: scenarios done`)
end

line("# Benchmarks: KeepBlox and the libraries games use today")
line()
line(`Generated by \`luneblox run bench/Report {seeds}\` on {os.date("!%Y-%m-%d")}. Every library runs unmodified`)
line("in the same simulator (tests/sim): the same fakes of DataStore, MessagingService and the engine, the")
line("same players, the same faults, and the same seeds. See Methodology below.")
line()
line("## Data safety")
line()
line(`Worst case over seeds 1-{seeds} for each scenario.`)
line()
line(
	"| Library | Violations | Crash: progress lost (steps) | Crash: player locked out | Longest stale owner (s) | Slowest open (s) | Failed opens | Library errors |"
)
line("|---|---|---|---|---|---|---|---|")
for _, row in rows do
	local violations, stale, slowest, failed, total, errors = 0, 0, 0, 0, 0, 0
	for _, soak in row.soaks do
		violations += #soak.violations
		stale = math.max(stale, soak.metrics.maxStaleSeconds)
		slowest = math.max(slowest, soak.metrics.maxOpenSeconds)
		failed += soak.metrics.failedOpens
		total += soak.metrics.opens + soak.metrics.failedOpens
		errors += #soak.failures
	end
	const crash = row.soaks.crash.metrics
	line(
		`| {row.name} | {violations} | {crash.maxProgressLost} | {crash.failedOpens} of {crash.opens + crash.failedOpens} rejoins | {fixed(
			stale
		)} | {fixed(slowest)} | {failed} of {total} | {errors} |`
	)
end
line()
line("## Cost")
line()
line("Requests per player per hour of play (20 players, one hour), and 50 players joining one server at once.")
line()
line(
	"| Library | Read | Write | Ordered read | Ordered write | Ordered list | Publishes | Join storm p50 / p99 / max (s) | Storm failures |"
)
line("|---|---|---|---|---|---|---|---|---|")
for _, entry in LIBRARIES do
	const hour = Cost.hour(entry.adapter, 1)
	const storm = Cost.storm(entry.adapter, 1)
	const cells = {}
	for _, requestType in TYPES do
		table.insert(cells, fixed(hour.perPlayerHour[requestType] or 0))
	end
	line(
		`| {entry.adapter.name} | {table.concat(cells, " | ")} | {fixed(hour.publishes)} | {fixed(storm.p50)} / {fixed(
			storm.p99
		)} / {fixed(storm.max)} | {storm.failed} of {storm.total} |`
	)
	print(`{entry.adapter.name}: cost done`)
end
line()
line("## Every scenario")
for _, row in rows do
	line()
	line(`### {row.name}`)
	line()
	line(
		"| Scenario | Progress lost (steps) | Stale owner (s) | Slowest open (s) | Failed opens | Shutdown (s) | Violations | Library errors |"
	)
	line("|---|---|---|---|---|---|---|---|")
	for _, name in ORDER do
		const soak = row.soaks[name]
		const m = soak.metrics
		const kinds: { [string]: number } = {}
		for _, violation in soak.violations do
			kinds[violation.invariant] = (kinds[violation.invariant] or 0) + 1
		end
		const listed = {}
		for kind, count in kinds do
			table.insert(listed, `{kind} x{count}`)
		end
		table.sort(listed)
		line(
			`| {name} | {m.maxProgressLost} | {fixed(m.maxStaleSeconds)} | {fixed(m.maxOpenSeconds)} | {m.failedOpens} of {m.opens + m.failedOpens} | {if soak.maxShutdownSeconds
					> 0
				then fixed(soak.maxShutdownSeconds)
				else "-"} | {if #listed == 0 then "none" else table.concat(listed, ", ")} | {#soak.failures} |`
		)
	end
end
line()
line("## Versions")
line()
for _, entry in LIBRARIES do
	line(`- {entry.adapter.name}: {entry.version}`)
end
line()
line(fs.readFile("bench/METHODOLOGY.md"))
fs.writeFile("bench/Benchmarks.md", table.concat(out, "\n"))
print("wrote bench/Benchmarks.md")
