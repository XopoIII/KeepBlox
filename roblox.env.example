# Copy to roblox.env, which is gitignored. Nothing here is secret yet; an Open Cloud key added later
# would be, and a key that reaches git history has to be rotated.

# The experience live checks and load tests run in: GP_TEST, a private experience nobody plays.
# Never run them in a live game: data store limits are shared by the whole experience
# (300 + 40 x players reads a minute), so a load test there throttles real players' saves.
# Studio needs Game Settings > Security > "Enable Studio Access to API Services" on.
KB_TEST_UNIVERSE_ID=10767242853
KB_TEST_PLACE_ID=88574054974490
