--!strict
const Clock = require("@fakes/Clock")
const Scheduler = require("@fakes/Scheduler")
const Sim = require("./Sim")
const Spec = require("../Spec")

Spec.test("Clock: skew shifts the wall clock, never the monotonic one", function()
	const scheduler = Scheduler.new(1)
	const ahead = Clock.new(scheduler, { group = "a", skew = 90, epoch = 1000 })
	const behind = Clock.new(scheduler, { group = "b", skew = -30, epoch = 1000 })
	Spec.equal(ahead.time(), 1090)
	Spec.equal(behind.time(), 970)
	Spec.equal(ahead.now(), 0)
	Sim.run(scheduler, "a", function()
		ahead.wait(12.5)
	end)
	Spec.equal(ahead.time(), 1102)
	Spec.equal(behind.time(), 982)
	Spec.equal(ahead.now(), 12.5)
	Spec.equal(behind.now(), 12.5)
end)

Spec.test("Clock: drift makes a clock read fast, while waits take true time", function()
	const scheduler = Scheduler.new(1)
	const fast = Clock.new(scheduler, { group = "a", drift = 0.01, epoch = 0 })
	local waited = -1
	Sim.run(scheduler, "a", function()
		waited = fast.wait(100)
	end)
	Spec.equal(waited, 100)
	Spec.equal(scheduler.now, 100)
	Spec.equal(fast.now(), 101)
	Spec.equal(fast.time(), 101)
end)

Spec.test("Clock: now() starts at the server's boot, time() at the shared epoch", function()
	const scheduler = Scheduler.new(1)
	scheduler:run(40)
	const late = Clock.new(scheduler, { group = "late", epoch = 5000 })
	Spec.equal(late.now(), 0)
	Spec.equal(late.time(), 5040)
	Spec.equal(Clock.trueMillis(scheduler, 5000), 5_040_000)
end)

Spec.test("Clock: spawn runs in the clock's group", function()
	const scheduler = Scheduler.new(1)
	const clock = Clock.new(scheduler, { group = "server-7" })
	local group: string? = nil
	clock.spawn(function()
		group = scheduler:currentGroup()
	end)
	scheduler:run()
	Spec.equal(group, "server-7")
end)

Spec.test("Clock: a drift that stops time is refused", function()
	Spec.throws(function()
		Clock.new(Scheduler.new(1), { group = "a", drift = -1 })
	end, "must keep the clock running forward")
end)

return nil
